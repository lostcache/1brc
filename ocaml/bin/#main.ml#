let num_threads = 16

module Fastmap = struct
  let map_size = 1 lsl 14
  let map_mask = map_size - 1

  type entry =
    { mutable key : string
    ; mutable min : int
    ; mutable max : int
    ; mutable sum : int
    ; mutable count : int
    }

  let create () =
    Array.init map_size (fun _ -> { key = ""; min = 1000; max = -1000; sum = 0; count = 0 })
  ;;

  let fast_hash_bytes buf start len =
    let h = ref 0 in
    for i = 0 to len - 1 do
      h := (!h * 1315423911) + Char.code (Bytes.unsafe_get buf (start + i))
    done;
    !h
  ;;

  let equals_bytes s buf start len =
    let slen = String.length s in
    if slen <> len
    then false
    else (
      let rec check i =
        if i = len
        then true
        else if String.unsafe_get s i <> Bytes.unsafe_get buf (start + i)
        then false
        else check (i + 1)
      in
      check 0)
  ;;

  let put map buf key_start key_len temp =
    let h = fast_hash_bytes buf key_start key_len in
    let rec insert i =
      let e = Array.unsafe_get map i in
      if e.count = 0
      then (
        e.key <- Bytes.sub_string buf key_start key_len;
        e.min <- temp;
        e.max <- temp;
        e.sum <- temp;
        e.count <- 1)
      else if equals_bytes e.key buf key_start key_len
      then (
        if temp < e.min then e.min <- temp;
        if temp > e.max then e.max <- temp;
        e.sum <- e.sum + temp;
        e.count <- e.count + 1)
      else insert ((i + 1) land map_mask)
    in
    insert (h land map_mask)
  ;;

  let put_entry map entry =
    let fast_hash_string s =
      let h = ref 0 in
      String.iter (fun c -> h := (!h * 1315423911) + Char.code c) s;
      !h
    in
    let h = fast_hash_string entry.key in
    let rec insert i =
      let e = Array.unsafe_get map i in
      if e.count = 0
      then (
        e.key <- entry.key;
        e.min <- entry.min;
        e.max <- entry.max;
        e.sum <- entry.sum;
        e.count <- entry.count)
      else if e.key = entry.key
      then (
        if entry.min < e.min then e.min <- entry.min;
        if entry.max > e.max then e.max <- entry.max;
        e.sum <- e.sum + entry.sum;
        e.count <- e.count + entry.count)
      else insert ((i + 1) land map_mask)
    in
    insert (h land map_mask)
  ;;
end

open Fastmap

let parse_temp_bytes buf offset _len =
  let p = ref offset in
  let sign =
    if Bytes.unsafe_get buf !p = '-'
    then (
      incr p;
      -1)
    else 1
  in
  let v =
    if Bytes.unsafe_get buf (!p + 1) = '.'
    then (
      let d1 = Char.code (Bytes.unsafe_get buf !p) - 48 in
      let d2 = Char.code (Bytes.unsafe_get buf (!p + 2)) - 48 in
      (d1 * 10) + d2)
    else (
      let d1 = Char.code (Bytes.unsafe_get buf !p) - 48 in
      let d2 = Char.code (Bytes.unsafe_get buf (!p + 1)) - 48 in
      let d3 = Char.code (Bytes.unsafe_get buf (!p + 3)) - 48 in
      (d1 * 100) + (d2 * 10) + d3)
  in
  v * sign
;;

let process_batch i start_pos end_pos file_path map = 
  let ic = open_in_bin file_path in
  if i > 0 then (
    seek_in ic (start_pos - 1);
    if input_char ic <> '\n' then ignore (input_line ic)
  ) else (
    seek_in ic 0
  );
  let current_offset = ref (pos_in ic) in
  
  if i == 0 then Printf.eprintf "Thread 0 starting at offset %d\n%!" !current_offset;

  let buf_size = 1024 * 1024 in
  let buf = Bytes.create buf_size in
  let buf_len = ref 0 in
  let buf_pos = ref 0 in
  let eof_reached = ref false in

  let refill () =
    let remaining = !buf_len - !buf_pos in
    if remaining > 0 then Bytes.blit buf !buf_pos buf 0 remaining;
    let n = input ic buf remaining (buf_size - remaining) in
    buf_len := remaining + n;
    buf_pos := 0;
    if n = 0 then (
        eof_reached := true;
        if i == 0 then Printf.eprintf "Thread 0 hit EOF at buf_len=%d remaining=%d\n%!" !buf_len remaining
    )
  in

  while !current_offset < end_pos do
    if !buf_pos > buf_size - 512 && not !eof_reached then refill ();
    if !buf_len = 0 && not !eof_reached then refill ();
    
    if !buf_pos < !buf_len then (
      let i_idx = ref !buf_pos in
      while !i_idx < !buf_len && Bytes.unsafe_get buf !i_idx <> '\n' do
        incr i_idx
      done;
      
      if !i_idx < !buf_len then (
        let nl_idx = !i_idx in
        let line_start = !buf_pos in
        
        let s = ref line_start in
        while !s < nl_idx && Bytes.unsafe_get buf !s <> ';' do
          incr s
        done;
        
        if !s < nl_idx then (
          let semi_idx = !s in
          let key_len = semi_idx - line_start in
          let temp_start = semi_idx + 1 in
          let temp_len = nl_idx - temp_start in
          
          let temp = parse_temp_bytes buf temp_start temp_len in
          Fastmap.put map buf line_start key_len temp;
          
          let consumed = nl_idx - line_start + 1 in
          current_offset := !current_offset + consumed;
          buf_pos := nl_idx + 1
        ) else (
          buf_pos := nl_idx + 1;
          current_offset := !current_offset + (nl_idx - line_start + 1)
        )
      ) else if not !eof_reached then (
        refill ()
      ) else (
        (* Last line without newline *)
        let line_start = !buf_pos in
        let s = ref line_start in
        while !s < !buf_len && Bytes.unsafe_get buf !s <> ';' do
          incr s
        done;
        if !s < !buf_len then (
          let semi_idx = !s in
          let key_len = semi_idx - line_start in
          let temp_start = semi_idx + 1 in
          let temp_len = !buf_len - temp_start in
          let temp = parse_temp_bytes buf temp_start temp_len in
          Fastmap.put map buf line_start key_len temp
        );
        current_offset := end_pos
      )
    ) else (
      current_offset := end_pos
    )
  done;
  close_in ic

let accumulate_batch_maps maps = 
  let final_map = Fastmap.create () in
  Array.iter (fun m ->
    Array.iter (fun e ->
      if e.count > 0 then Fastmap.put_entry final_map e
    ) m
  ) maps;
  final_map

let print_results final_map = 
  let valid_entries = ref [] in
  Array.iter (fun (e: Fastmap.entry) ->
    if e.count > 0 then valid_entries := e :: !valid_entries
  ) final_map;
  let sorted_entries = List.sort (fun a b -> String.compare a.key b.key) !valid_entries in

  Printf.printf "{";
  let first = ref true in
  List.iter (fun s ->
    if not !first then Printf.printf ", ";
    first := false;
    let min_f = float_of_int s.min /. 10.0 in
    let max_f = float_of_int s.max /. 10.0 in
    let mean_f = Float.round (float_of_int s.sum /. float_of_int s.count) /. 10.0 in
    Printf.printf "%s=%.1f/%.1f/%.1f/%d" s.key min_f mean_f max_f s.count
  ) sorted_entries;
  Printf.printf "}\n"

let process_in_single_batch file_path file_size = 
  let map = Fastmap.create () in
  process_batch 0 0 file_size file_path map;
  print_results map

let process_in_multiple_batches file_path file_size = 
  let chunk_size = file_size / num_threads in
  let domains = Array.init num_threads (fun i ->
      let start_pos = i * chunk_size in
      let end_pos = if i = num_threads - 1 then file_size else (i + 1) * chunk_size in
      if i == 0 then Printf.eprintf "Thread 0: %d -> %d\n%!" start_pos end_pos;
      let map = Fastmap.create () in
      Domain.spawn (fun () -> 
        process_batch i start_pos end_pos file_path map;
        map
      )
    ) in
    let maps = Array.map Domain.join domains in
    print_results (accumulate_batch_maps maps)

let one_brc file_path = 
  let ic = open_in_bin file_path in
  let file_size = in_channel_length ic in
  close_in ic;
  Printf.eprintf "VERSION 2\n";
  Printf.eprintf "Sys.word_size: %d\n" Sys.word_size;
  Printf.eprintf "Processing file: %s, Size: %d bytes, Threads: %d\n%!" file_path file_size num_threads;

  if file_size <= 4096 then (
    process_in_single_batch file_path file_size
  ) else (
    process_in_multiple_batches file_path file_size
  )

let () = lol.pli

let () =
  one_brc
    (match Array.length Sys.argv = 2 with
     | true -> Sys.argv.(1)
     | false -> "../data/measurements.txt")
;;
